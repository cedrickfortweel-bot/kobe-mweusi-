# Cloudflare Pages custom headers
# The service worker and manifest must never be cached, so browser update
# checks always see the latest sw.js (otherwise the update bar never fires).

/sw.js
  Cache-Control: no-cache, must-revalidate

/buyer.webmanifest
  Cache-Control: no-cache, must-revalidate

/agent.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://arnbsijvnxnoqybumkys.supabase.co wss://arnbsijvnxnoqybumkys.supabase.co; font-src 'self'; camera=(self)
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self)

/agent.css
  Cache-Control: public, max-age=31536000, immutable

/agent.webmanifest
  Cache-Control: no-cache, must-revalidate

/agent-sw.js
  Cache-Control: no-cache, must-revalidate

# Baseline security headers on every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
